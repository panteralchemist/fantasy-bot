# Copy this file to .env and fill it in. NEVER commit .env, and do not paste
# these values into a chat - fill them in here yourself.

# --- Yahoo Fantasy API -------------------------------------------------
# From https://developer.yahoo.com/apps/create/
#   OAuth Client Type: Confidential Client
#   API Permissions:   Fantasy Sports (the "Read" sub-option is the only one
#                      Yahoo offers as of Sep 2026 - Read/Write is gone)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Must match the Redirect URI registered on the Yahoo app EXACTLY.
# Yahoo rejects "oob" with "Invalid URI." - an https:// URI is mandatory now.
# Nothing needs to listen on this address: after you approve, the browser will
# show a connection error and the code sits in the address bar for you to copy.
YAHOO_REDIRECT_URI=https://localhost:8080/callback

# Written automatically by `uv run python yahoo_client.py` on first run.
# The refresh token is long-lived - this is the "access in perpetuity" piece.
YAHOO_REFRESH_TOKEN=

# --- League ------------------------------------------------------------
LEAGUE_ID=891227
TEAM_ID=6

# --- Email -------------------------------------------------------------
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification on). That password is NOT your Google password
# and can be revoked independently.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=
MAIL_TO=you@example.com
